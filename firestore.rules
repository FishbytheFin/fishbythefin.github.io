rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /purchases/{giftId} {
      allow read: if true;
      // Keep this list in sync with the IDs in gifts.json.
      allow create: if giftId in ['pixel-wave', 'dolphin-sweater', 'cozy-blanket']
        && request.resource.data.keys().hasAll(['purchasedAt'])
        && request.resource.data.keys().hasOnly(['purchasedAt'])
        && request.resource.data.purchasedAt == request.time;
      allow update, delete: if false;
    }
  }
}
